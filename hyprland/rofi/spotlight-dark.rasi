* {
    bg0:    #1e1e2ef2;
    bg1:    #313244;
    bg2:    #45475a;
    fg0:    #cdd6f4;
    fg1:    #a6adc8;
    accent: #89b4fa;

    background-color: transparent;
    text-color: @fg0;
    margin: 0;
    padding: 0;
    spacing: 0;
}

window {
    location: center;
    width: 580px;
    border-radius: 14px;
    background-color: @bg0;
    border: 2px solid @bg2;
}

mainbox {
    padding: 12px;
}

inputbar {
    background-color: @bg1;
    border-radius: 10px;
    padding: 10px 14px;
    spacing: 10px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @accent;
}

entry {
    placeholder: "Search apps...";
    placeholder-color: @fg1;
}

listview {
    margin: 12px 0 0 0;
    lines: 7;
    columns: 1;
    fixed-height: false;
}

element {
    padding: 8px 12px;
    spacing: 12px;
    border-radius: 8px;
}

element selected normal, element selected active {
    background-color: @accent;
    text-color: #11111b;
}

element-icon {
    size: 26px;
}

element-text {
    vertical-align: 0.5;
    text-color: inherit;
}
